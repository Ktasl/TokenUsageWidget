{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenUsageWidget",
  "mainBinaryName": "tokenusagewidget",
  "identifier": "io.github.ktasl.tokenusagewidget.test",
  "build": {
    "beforeBuildCommand": "bun run bundle:plugins && VITE_TOKEN_USAGE_TEST_BUILD=1 VITE_TOKEN_USAGE_BUILD_NUMBER=20261106.1 bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenUsageWidget",
        "width": 820,
        "height": 500,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "test-build",
          "description": "Independent local test build",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:tray:default",
            "core:image:default",
            "core:window:allow-set-size",
            "core:window:allow-outer-size",
            "core:window:allow-inner-size",
            "core:window:allow-scale-factor",
            "opener:default",
            "store:default",
            "process:allow-restart",
            "global-shortcut:default",
            "autostart:default",
            "clipboard-manager:allow-write-text",
            "core:menu:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "bundleVersion": "20261106.1"
    },
    "resources": [
      "resources/bundled_plugins/**/*",
      "icons/tray-icon.png",
      "../LICENSE"
    ]
  },
  "plugins": {
    "updater": null
  }
}
